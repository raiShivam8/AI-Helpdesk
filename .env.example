# -----------------------------------------------------------------------------
# AI Helpdesk Application Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# -----------------------------------------------------------------------------

# Application Basics
APP_NAME="AI Helpdesk"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database Configuration (PostgreSQL recommended for Production)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=helpdesk_prod
DB_USERNAME=helpdesk_user
DB_PASSWORD=your_secure_db_password

# Drivers & Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Support Email (Customer sends queries here)
SUPPORT_EMAIL=support@yourdomain.com
SUPPORT_NAME="AI Helpdesk"

# SMTP (Send Emails)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your_gmail_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM_ADDRESS=support@yourdomain.com
MAIL_FROM_NAME="${SUPPORT_NAME}"

# Optional: Development/Testing Email Override (Leave empty in Production)
TEST_RECIPIENT_EMAIL=

# API
API_BASE_URL=https://yourdomain.com

# Webhook
WEBHOOK_SECRET=your_production_webhook_secret

# IMAP (Receive Emails)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_PROTOCOL=imap
IMAP_USERNAME=your_gmail_email@gmail.com
IMAP_PASSWORD=your_gmail_app_password
IMAP_VALIDATE_CERT=true

# Admin Account Seeding Settings
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_secure_password

# Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=30
GEMINI_CONNECT_TIMEOUT=10
GEMINI_CACHE_STORE=file
GEMINI_CACHE_TTL=86400

# Sentry Error Tracking (Optional)
SENTRY_DSN=
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
